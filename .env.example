# Template Konfigurasi Toko Tunggal (Single-Tenant)
# Salin file ini menjadi .env dan sesuaikan nilainya untuk toko masing-masing

# Supabase Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Profil Toko
VITE_STORE_SLUG=nama-toko-anda
VITE_STORE_NAME=Nama Toko SR12 Anda
VITE_STORE_TAGLINE=Distributor / Agen Resmi SR12
VITE_STORE_OWNER=Nama Pemilik
VITE_STORE_CITY=Kota Toko
VITE_STORE_WA=6281234567890
VITE_STORE_THEME=emerald
VITE_STORE_ADMIN_PIN=1234
VITE_STORE_OWNER_EMAIL=admin@tokoanda.com
VITE_STORE_ADMIN_PASSWORD=PasswordAdmin123!

